{
    "hyprland/language": {
        "format-en": "us",
        "format-ru": "ru"
    },
    "custom/power": {
        "format" : "󰐥",
        "tooltip": false,
        "on-click": "wlogout"
    },
    "hyprland/workspaces": {
        "format": "{icon} {windows}",
        "persistent-workspaces": {
            "*": 9
        },
        "workspace-taskbar": {
            "enable": true,
            "update-active-window": true,
            "format": "{icon}",
            "icon-size": 16
        }
    },
    // "custom/cava": {
    //     "exec": "~/.config/waybar/cava.sh",
    //     "tooltip": false,
    //     "restart-interval": 1
    // },
    "temperature": {
        // "thermal-zone": 2,
        // "hwmon-path": "/sys/class/hwmon/hwmon2/temp1_input",
        "critical-threshold": 80,
        "format": " {temperatureC}°C",
        "tooltip": false
    },
    "memory": {
        "format": " {used:0.1f} GiB",
        "tooltip": false
        // "format-warning": " {used:0.1f} GiB",
        // "format-critical": " {used:0.1f} GiB",
        // "states": {
        //     "warning": 5,
        //     "critical": 90
        // }
    },
    "cpu": {
        "format": " {usage}%",
        "tooltip": false
    },
    "network": {
        // "interface": "wlp2*", // (Optional) To force the use of this interface
        "format-wifi": "{icon} {essid}",
        "format-icons": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
        "format-ethernet": "󰈁 {essid}",
        "format-disconnected": " Disconnected"
    },
    "backlight": {
        // "device": "acpi_video1",
        "format": "{icon} {percent}%",
        "format-icons": ["", "", "", "", "", "", "", "", ""]
    },
    "pulseaudio": {
        "scroll-step": 0.2,
        "format": "{format_source} {icon} {volume}%",
        "format-bluetooth": "{volume}% {icon} ",
        "format-bluetooth-muted": " {icon} {format_source}",
        "format-muted": " {format_source}",
        "format-source": "",
        "format-source-muted": "",
        "format-icons": {
            "default": ["", "", ""],
            "headphone": ""
        },
        "on-click": "pavucontrol"
    },
    "battery": {
        // "states": {
            // "good": 95,
            // "warning": 30,
            // "critical": 15
        // },
        "format": "{icon} {capacity}%",
        "format-plugged": "{capacity}% ",
        "format-icons": {
            "default": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
            "charging": ["󰢟", "󰢜", "󰂆", "󰂇", "󰂈", "󰢝", "󰂉", "󰢞", "󰂊", "󰂋", "󰂅"]
        }
    },
    "clock": {
        "format": "{:%a %b %d %H:%M}",
        "tooltip": false
    }

}