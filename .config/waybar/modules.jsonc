{
    "custom/power": {
        "format" : "󰐥",
        "tooltip": false,
        "on-click": "wlogout"
    },
    "hyprland/workspaces": {
        "format": "{icon} {windows}",
        "persistent-workspaces": {
            "*": 9
        },
        "workspace-taskbar": {
            "enable": true,
            "update-active-window": true,
            "format": "{icon}",
            "icon-size": 18
        }
    },
    // "custom/cava": {
    //     "exec": "~/.config/waybar/cava.sh",
    //     "tooltip": false,
    //     "restart-interval": 1
    // },
    "temperature": {
        // "thermal-zone": 2,
        // "hwmon-path": "/sys/class/hwmon/hwmon2/temp1_input",
        "critical-threshold": 80,
        "format": " {temperatureC}°C",
        "tooltip": false
    },
    "memory": {
        "format": " {used:0.1f} GiB",
        "tooltip": false
        // "format-warning": " {used:0.1f} GiB",
        // "format-critical": " {used:0.1f} GiB",
        // "states": {
        //     "warning": 5,
        //     "critical": 90
        // }
    },
    "hyprland/language": {
        "format-en": "us",
        "format-ru": "ru"
    },
    "cpu": {
        "format": " {usage}%",
        "tooltip": false
    },
    "network": {
        // "interface": "wlp2*", // (Optional) To force the use of this interface
        "format-wifi": "{icon} {essid}",
        "format-icons": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
        "format-ethernet": "󰈁 {essid}",
        "format-disconnected": " Disconnected"
    },
    "backlight": {
        // "device": "acpi_video1",
        "format": "{icon} {percent}%",
        "format-icons": ["", "", "", "", "", "", "", "", ""]
    },
    "battery": {
        "states": {
            // "good": 95,
            // "warning": 30,
            // "critical": 15
        },
        "format": "{icon} {capacity}%",
        "format-full": "{icon} {capacity}%",
        "format-charging": "{capacity}% ",
        "format-plugged": "{capacity}% ",
        // "format-good": "", // An empty format will hide the module
        // "format-full": "",
        "format-icons": ["", "", "", "", ""]
    },
    "clock": {
        "format": "{:%a %b %d %I:%M %p}",
        "tooltip": false
    }

}